generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id         String   @id @default(uuid())
  username   String
  avatarUrl  String?
  createdAt  DateTime @default(now())

  hostedRooms Room[] @relation("RoomHost")
  memberships RoomMember[]
  rounds      Round[]
}

model Room {
  id          String   @id @default(uuid())
  roomCode    String   @unique
  roomName    String
  hostId      String?
  host        Player?  @relation("RoomHost", fields: [hostId], references: [id])
  status      String   @default("WAITING") // WAITING, IN_GAME, FINISHED
  maxPlayers  Int      @default(4)
  createdAt   DateTime @default(now())

  members     RoomMember[]
  rounds      Round[]
}

model RoomMember {
  roomId    String
  playerId  String
  joinedAt  DateTime @default(now())

  room      Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id])

  @@id([roomId, playerId])
}

model Round {
  id           String   @id @default(uuid())
  roomId       String
  roundNumber  Int
  secretWord   String
  spyId        String?
  outcome      String?
  createdAt    DateTime @default(now())

  room Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  spy  Player? @relation(fields: [spyId], references: [id])
}
